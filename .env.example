# Backend origin that /api/* requests are proxied to (server-side rewrite).
# Optional override: production defaults to https://ss-production-server.vercel.app;
# development defaults to http://localhost:4000.
BACKEND_URL=http://localhost:4000

# Path the browser uses for API calls. Keep it relative so auth cookies stay first-party.
NEXT_PUBLIC_API_URL=/api/v1

# Public origin of the app (canonical URLs, Open Graph, robots.txt and sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
